@@page
@model PdfChargesSummary.Pages.SummaryModel
@{
    ViewData["Title"] = "Monthly Settlement Summary";
}

<div class="container" id="printArea">
    <div class="summary-header">
        <h1>Monthly Settlement Summary</h1>
        <p>Generated: @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</p>
        <p>Documents processed: @Model.Charges.Count</p>
    </div>

    @if (Model.Charges.Count > 0)
    {
        <div class="tally-strip">
            <div class="tally-item">
                <p class="label">POS Total</p>
                <p class="value">@Model.PosTotalSum.ToString("N2")</p>
            </div>
            <div class="tally-item">
                <p class="label">VAT</p>
                <p class="value">@Model.VatSum.ToString("N2")</p>
            </div>
            <div class="tally-item">
                <p class="label">Commission</p>
                <p class="value">@Model.CommissionSum.ToString("N2")</p>
            </div>
            <div class="tally-item">
                <p class="label">Fee</p>
                <p class="value">@Model.FeeSum.ToString("N2")</p>
            </div>
            <div class="tally-item net">
                <p class="label">Net Total</p>
                <p class="value">@Model.NetTotalSum.ToString("N2")</p>
            </div>
        </div>
    }

    @if (Model.Charges.Count == 0)
    {
        <p>No data to display. <a asp-page="/Upload">Upload PDFs</a> first.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="summary-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>File</th>
                        <th>Date</th>
                        <th>POS Total</th>
                        <th>VAT</th>
                        <th>Commission</th>
                        <th>Fee</th>
                        <th>Net Total</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var c in Model.Charges)
                    {
                        <tr class="@(c.ParseWarning ? "warning-row" : "")">
                            <td>@i</td>
                            <td>
                                @c.FileName
                                @if (c.ParseWarning)
                                {
                                    <span class="badge-warning">check fields</span>
                                }
                            </td>
                            <td>@(c.DocumentDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>@c.PosTotal.ToString("N2")</td>
                            <td>@c.Vat.ToString("N2")</td>
                            <td>@c.Commission.ToString("N2")</td>
                            <td>@c.Fee.ToString("N2")</td>
                            <td>@c.NetTotal.ToString("N2")</td>
                        </tr>
                        @if (c.ParseWarning)
                        {
                            <tr class="warning-note">
                                <td></td>
                                <td colspan="7">⚠ @c.WarningMessage</td>
                            </tr>
                        }
                        i++;
                    }
                </tbody>
                <tfoot>
                    <tr class="totals-row">
                        <td colspan="3">Grand Totals</td>
                        <td>@Model.PosTotalSum.ToString("N2")</td>
                        <td>@Model.VatSum.ToString("N2")</td>
                        <td>@Model.CommissionSum.ToString("N2")</td>
                        <td>@Model.FeeSum.ToString("N2")</td>
                        <td><strong>@Model.NetTotalSum.ToString("N2")</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

<div class="action-bar no-print">
    <button onclick="window.print()" class="btn-primary">🖨 Print This Page</button>
    <a asp-page="/Upload" class="btn-secondary">Upload More PDFs</a>
</div>
